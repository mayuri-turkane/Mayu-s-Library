import { useSanityBlogs } from '@/lib/useSanityBlogs';
import Link from 'next/link';
import Image from 'next/image';

export default function BlogsPage() {
  const { blogs, loading, error } = useSanityBlogs();
  if (loading) return <p>Loading�</p>;
  if (error) return <p>Error loading blogs: {error.message}</p>;
  return (
    <section style={{ padding: '2rem', maxWidth: '800px', margin: '0 auto' }}>
      <h1>All Blogs</h1>
      {!blogs.length ? <p>No blogs found.</p> : (
        <ul style={{ listStyle: 'none', padding: 0 }}>
          {blogs.map((blog) => (
            <li key={blog._id} style={{ marginBottom: '2rem' }}>
              {blog.mainImage && (
                <Image
                  src={blog.mainImage.asset.url}
                  alt={blog.title}
                  width={400}
                  height={250}
                  style={{ borderRadius: '8px', objectFit: 'cover' }}
                />
              )}
              <Link
                href={`/blogs/${blog.slug.current}`}
                style={{ textDecoration: 'none', color: 'inherit', display: 'block', marginTop: '0.5rem' }}
              >
                <h2>{blog.title}</h2>
                <p>{blog.excerpt ?? 'Read more�'}</p>
                <small>
                  Published: {new Date(blog.publishedAt).toLocaleDateString()}
                  {blog.author?.[0]?.name && ` � By ${blog.author[0].name}`}
                </small>
              </Link>
            </li>
          ))}
        </ul>
      )}
    </section>
  );
}
